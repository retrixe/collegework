<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="xyz.retrixe.SecurityController" stylesheets="@style.css">

    <VBox fx:id="loginScreen" alignment="CENTER" spacing="15" styleClass="login-bg">
        <Label text="ASCON-128 Cryptographic Tool" style="-fx-font-size: 24; -fx-text-fill: #00ffcc;"/>
        <TextField fx:id="usernameField" promptText="Username" maxWidth="250"/>
        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250"/>
        <Button text="AUTHORIZE" onAction="#handleLogin" prefWidth="250"/>
        <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword" style="-fx-text-fill: #666;"/>
        <Hyperlink text="New user? Create an account" onAction="#showRegisterScreen" style="-fx-text-fill: #666;"/>
        <Label fx:id="statusLabel" style="-fx-text-fill: red;"/>
    </VBox>

    <VBox fx:id="registerScreen" visible="false" managed="false" alignment="CENTER" spacing="10" style="-fx-padding: 30;">
        <Label text="Identity Provisioning" style="-fx-font-size: 20; -fx-text-fill: #00ffcc;"/>

        <TextField fx:id="regFullName" promptText="Full Name" maxWidth="300"/>
        <TextField fx:id="regEmail" promptText="Email Address" maxWidth="300"/>
        <TextField fx:id="regPhone" promptText="Phone Number" maxWidth="300"/>
        <TextArea fx:id="regAddress" promptText="Physical Address" maxWidth="300" prefHeight="60" wrapText="true"/>

        <Separator maxWidth="250" style="-fx-opacity: 0.3;"/>

        <TextField fx:id="regUsername" promptText="Choose Username" maxWidth="300"/>
        <PasswordField fx:id="regPassword" promptText="Choose Password" maxWidth="300"/>

        <Button fx:id="regSubmitButton" text="SEND VERIFICATION OTP" onAction="#handleRegister" prefWidth="300" styleClass="action-button"/>

        <Hyperlink text="Already have an account? Login" onAction="#showLoginScreen" style="-fx-text-fill: #666;"/>
    </VBox>

    <VBox fx:id="otpScreen" visible="false" managed="false" alignment="CENTER" spacing="15">
        <Label text="Enter 6-Digit Code" style="-fx-text-fill: #ffcc00;"/>
        <TextField fx:id="otpInput" promptText="X X X X X X" maxWidth="150" alignment="CENTER" style="-fx-font-size: 18;"/>
        <Button text="VERIFY &amp; CREATE ACCOUNT" onAction="#handleVerifyOTP" prefWidth="200"/>
    </VBox>

    <HBox fx:id="mainApp" visible="false">
        <VBox styleClass="sidebar" prefWidth="200" spacing="10" style="-fx-padding: 15;">
            <Label text="MANAGEMENT" style="-fx-text-fill: #555;"/>
            <Button text="Ascon Crypto" onAction="#showEncryptionPanel" prefWidth="170"/>

            <Button fx:id="btnUserManager" text="User Manager" onAction="#showUserManagement" prefWidth="170"/>
            <Button fx:id="btnAdminLogs" text="System Logs" onAction="#showAdminLogs" prefWidth="170"/>

            <Region VBox.vgrow="ALWAYS" />
            <Button text="LOGOUT" onAction="#handleLogout" prefWidth="170" style="-fx-border-color: #ff4444; -fx-text-fill: #ff4444;"/>
        </VBox>

        <StackPane HBox.hgrow="ALWAYS">
            <VBox fx:id="encryptionPanel" spacing="10" style="-fx-padding: 20;">
                <Label text="Ascon-128 AEAD Operation" style="-fx-font-size: 18;"/>
                <HBox spacing="10">
                    <TextField fx:id="keyField" promptText="Hex Key (16 bytes)"/>
                    <TextField fx:id="nonceField" promptText="Hex Nonce (16 bytes)"/>
                    <TextField fx:id="adField" promptText="Associated Data"/>
                </HBox>
                <TextArea fx:id="inputArea" promptText="Plaintext (Encrypt) or HexCT:HexTag (Decrypt)"/>
                <HBox spacing="10">
                    <Button text="Encrypt" onAction="#handleEncrypt" styleClass="action-button"/>
                    <Button text="Decrypt" onAction="#handleDecrypt"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="hexModeToggle" text="Input/Output as Hex" style="-fx-text-fill: #00ffcc;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Load Test Vectors" onAction="#handlePrefill" style="-fx-font-size: 10;"/>
                </HBox>
                <TextArea fx:id="outputArea" editable="false"/>
            </VBox>

            <VBox fx:id="userManagementPanel" visible="false" spacing="10" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #332200; -fx-padding: 10; -fx-background-radius: 5;">
                    <Label text="⚠ PENDING RESET REQUESTS:" style="-fx-text-fill: #ffcc00; -fx-font-weight: bold;"/>
                    <Label fx:id="pendingCountLabel" text="0" style="-fx-text-fill: white;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="View Requests" onAction="#filterPendingUsers" style="-fx-font-size: 10;"/>
                </HBox>

                <Label text="Identity Management" style="-fx-font-size: 18; -fx-text-fill: white;"/>

                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="150" />
                        <TableColumn fx:id="colPassword" text="Password" prefWidth="150" />
                        <TableColumn fx:id="colRole" text="Role" prefWidth="100" />
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <PasswordField fx:id="adminResetPassField" promptText="New password for selected"/>
                    <Button text="Reset Password" onAction="#handleResetPassword"
                            style="-fx-background-color: #334433; -fx-text-fill: #00ffcc;"/>
                </HBox>

                <HBox spacing="10">
                    <Button text="Delete Selected User" onAction="#handleDeleteUser"
                            style="-fx-background-color: #442222; -fx-text-fill: #ff4444;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Refresh Table" onAction="#refreshUserTable"/>
                </HBox>

                <HBox spacing="10">
                    <TextField fx:id="newUserName" promptText="New Username"/>
                    <PasswordField fx:id="newUserPass" promptText="New Password"/>
                    <ComboBox fx:id="roleSelector" promptText="Select Role"/>
                    <Button text="Add User" onAction="#handleAddUser" styleClass="action-button"/>
                </HBox>
            </VBox>

            <VBox fx:id="adminLogsPanel" visible="false" spacing="10" style="-fx-padding: 20;">
                <Label text="Security Audit Trail" style="-fx-font-size: 18;"/>
                <TextArea fx:id="logArea" VBox.vgrow="ALWAYS" editable="false" styleClass="console"/>
            </VBox>
        </StackPane>
    </HBox>
</StackPane>
